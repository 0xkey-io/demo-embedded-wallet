NEXT_PUBLIC_APP_URL=http://localhost:3200
NEXT_PUBLIC_BASE_URL=https://api.0xkey.io
NEXT_PUBLIC_ORGANIZATION_ID=<your-organization-id>
NEXT_PUBLIC_RP_ID=<your-rp-id>
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=<your-google-oauth-client-id>
NEXT_PUBLIC_APPLE_OAUTH_CLIENT_ID=<your-apple-oauth-client-id>
NEXT_PUBLIC_FACEBOOK_CLIENT_ID=<your-facebook-oauth-client-id>
NEXT_PUBLIC_FACEBOOK_GRAPH_API_VERSION=21.0
NEXT_PUBLIC_FACEBOOK_AUTH_VERSION=11.0

# Auth Proxy config ID from your 0xkey dashboard.
# For local development, the default dev config ID is fixed to:
# 00000000-0000-4000-8000-0000000000b1
NEXT_PUBLIC_AUTH_PROXY_ID=00000000-0000-4000-8000-0000000000b1
# Auth Proxy base URL. Wallet Kit reads /v1/wallet_kit_config from this host.
NEXT_PUBLIC_AUTH_PROXY_URL=https://auth.0xkey.io

# Optional default recipient address shown in the transfer dialog.
NEXT_PUBLIC_DEFAULT_RECIPIENT_ADDRESS=0x0EBd561A3C64CcBb208ed066E0aC0A7731c99fF8

# Web3 + pricing (Alchemy key is exposed to the browser for Sepolia RPC)
NEXT_PUBLIC_ALCHEMY_API_KEY=

# Server-only
COINGECKO_API_KEY=

ZEROXKEY_API_PUBLIC_KEY=
ZEROXKEY_API_PRIVATE_KEY=
ZEROXKEY_WARCHEST_API_PUBLIC_KEY=
ZEROXKEY_WARCHEST_ORGANIZATION_ID=
ZEROXKEY_WARCHEST_API_PRIVATE_KEY=
WARCHEST_PRIVATE_KEY_ID=

# Use any randomly generated alphanumeric string
FACEBOOK_SECRET_SALT=
